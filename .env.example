# ============================================================
# OpenJellyfish 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- 实例卡死 / SSH 连不上时的最小恢复（部署在宿主机 .env，重建容器生效）----
# 设为 1 时本进程强制：不调度定时任务 + 不批量 pip 恢复 venv（先让 CPU/内存降下来）
# SAFE_STARTUP=1
# 仍需手工关容器时可：sudo systemctl stop docker
# 详见 main.py::_apply_safe_startup

# ---- Provider 默认配置（使用 DeepAgents / API 能力时配置相应 API Key） ----
# 仅使用已授权 Codex / Cursor 登录连接时，无需填写 LLM API Key。
# 仍需安装对应 CLI、启用下方 Runtime，并由超管完成登录及模型授权。

# Anthropic（LLM 对话）
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_BASE_URL=                     # 留空 = https://api.anthropic.com

# OpenAI（LLM 对话 + 图片/语音/视频生成 + 实时语音 + 语音转写）
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_BASE_URL=                        # 留空 = https://api.openai.com/v1

# AWS Bedrock（Bearer ABSK + InvokeModel；平台 Key）
# BEDROCK_API_KEY=ABSK-xxxxx
# BEDROCK_REGION=us-east-1

# OpenRouter（OpenAI-compat 聚合；白名单在设置页勾选）
# OPENROUTER_API_KEY=sk-or-xxxxx
# OPENROUTER_BASE_URL=                    # 留空 = https://openrouter.ai/api/v1

# 硅基流动 SiliconFlow（国内 OpenAI-compat 聚合；白名单在设置页勾选）
# SILICONFLOW_API_KEY=sk-xxxxx
# SILICONFLOW_BASE_URL=                   # 留空 = https://api.siliconflow.cn/v1（海外站点 .com）
# SILICONFLOW_HYBRID_MODELS=              # 逗号分隔，补充支持 enable_thinking 的新模型

# ---- 按能力可选覆盖（不填则使用上面的 OPENAI_* 默认值） ----

# 图片生成（gpt-image-2）
# IMAGE_API_KEY=
# IMAGE_BASE_URL=

# TTS 语音生成（tts-1）
# TTS_API_KEY=
# TTS_BASE_URL=

# 视频生成（sora-2）
# VIDEO_API_KEY=
# VIDEO_BASE_URL=

# 实时语音对话（gpt-4o-realtime）
# S2S_API_KEY=
# S2S_BASE_URL=

# 语音转写（whisper-1）
# STT_API_KEY=
# STT_BASE_URL=

# ---- 联网工具（二选一或同时配置） ----

# CloudsWay 搜索 API（自有服务，优先使用）
# CLOUDSWAY_SEARCH_KEY=
# CLOUDSWAY_READ_URL=https://searchapi.cloudsway.net/search/<read_id>/read
# CLOUDSWAY_SEARCH_URL=https://searchapi.cloudsway.net/search/<search_id>/smart

# Tavily 搜索 API（备选，CLOUDSWAY_SEARCH_KEY 未设置时使用）
# TAVILY_API_KEY=tvly-xxxxx

# ---- 可选配置 ----

# Langfuse 可观测性
# LANGFUSE_SECRET_KEY=sk-lf-xxxxx
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# LangChain 追踪
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__xxxxx
# LANGCHAIN_PROJECT=openjellyfish

# 服务配置
# UVICORN_WORKERS=1
# LOG_LEVEL=info

# ---- 定时任务调度器（OOM 防护）----
# 设为 1/true/yes/on 时跳过 HeapScheduler.start()（仅救火；编排 API 仍在，但不会自动按期执行）
# DISABLE_SCHEDULER=
# 同时处于执行中的定时任务上限（每条 agent 约 100–300MB）；4GB 机器建议 2～4，8GB 可 6～8
# SCHEDULER_MAX_CONCURRENT=4

# ---- 定时任务失控防护（防止任务空转烧 LLM 调用）----
# 同一任务连续失败多少次后自动禁用（重新启用时计数清零）；0 = 关闭该保护
# SCHEDULER_MAX_CONSECUTIVE_FAILURES=5
# 同一任务两次执行之间的最小间隔秒数，仅在「跑完重排下次」时生效，不影响创建即执行；0 = 关闭该保护
# SCHEDULER_MIN_RUN_INTERVAL_S=5
# 单条 spawn 谱系每小时可派生的子任务上限（app/services/spawn_limits.py）
# SCHED_SPAWN_RATE_PER_HOUR=30

# ---- 启动时用户 venv 恢复（CPU 防护）----
# 若设为 0/false/no/off，则跳过「扫描 users/*/venv/requirements.txt 并 pip install -r」（启动瞬间更轻）
# RESTORE_VENVS_ON_STARTUP=
# 有 requirements.txt 的用户之间，最多几人并行 pip（默认 1=顺序执行，避免多用户同时 pip 把 CPU 打满）
# RESTORE_VENVS_CONCURRENCY=1

# ---- 文件存储后端（可选，默认 local） ----
# STORAGE_BACKEND=local              # local | s3
# S3_BUCKET=openjellyfish-files
# S3_REGION=                         # 留空自动：R2 端点→auto，其余→us-east-1
# S3_ENDPOINT_URL=                   # 留空 = AWS S3，填自定义端点 = MinIO/R2/OSS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=                         # 可选全局键前缀
# S3_ADDRESSING_STYLE=               # 留空自动；部分 MinIO 部署需要 path
# S3_CHECKSUM_MODE=                  # auto(默认) | when_supported | when_required
#   boto3 1.36+ 默认给每次上传加 CRC32 完整性头，部分 S3 兼容实现会直接报错。
#   auto = 配了 S3_ENDPOINT_URL（即非 AWS）就用 when_required。
#
# Cloudflare R2 示例：
#   STORAGE_BACKEND=s3
#   S3_BUCKET=openjellyfish
#   S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID=<R2 Access Key ID>
#   S3_SECRET_ACCESS_KEY=<R2 Secret Access Key>
#   # region / checksum 不用填，按端点自动判定
#   注意：媒体走 presigned URL 302 跳转，<img> 直接可用；若前端要用 fetch/XHR
#   读这些 URL，需要在 R2 桶上配 CORS 允许你的域名。
#
# S3 本地缓存（仅 s3 模式生效，缓存目录 data/s3cache/）
# S3_CACHE_ENABLED=true              # 关掉则每次读写都直连 S3
# S3_CACHE_MAX_MB=2048               # 磁盘内容缓存上限，超出按最久未用淘汰
# S3_CACHE_MAX_FILE_MB=64            # 超过此大小的对象不进缓存，直接流式读写
# S3_META_TTL_SECONDS=5              # head/list 结果的进程内缓存时长

# 脚本沙箱物化上限（local 与 s3 都生效）
# 单次脚本执行最多把多少 docs/ + scripts/ 放进沙箱工作目录；
# 正在执行的那个脚本本身不受此限制。
# SANDBOX_MAX_MB=512

# 端口映射 (docker-compose)
# FRONTEND_PORT=3030
# API_PORT=3033

# ---- LiveKit 实时语音插件（可选）----
# 启用语音前台时配置。详见 plugins/voice/README.md 与 docker-compose.voice.yml。
#
# LIVEKIT_URL 是「浏览器」要连接的 SFU 地址，必须是浏览器可达的公网地址。
# 切勿用 localhost —— localhost 指浏览器所在的机器（你本地电脑），不是 EC2！
#   · 通过 http://<EC2公网IP> 访问前端：LIVEKIT_URL=ws://<EC2公网IP>:7880
#   · 通过 https://<域名> 访问前端：需用 wss（经 nginx 反代到 7880），
#     例如 LIVEKIT_URL=wss://<域名>/livekit （否则浏览器拦截 ws 混合内容）
# LIVEKIT_URL=ws://<EC2公网IP>:7880
# 与 livekit-server keys 一致（见 livekit/livekit.yaml，默认 devkey/secret）。
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# Core 与语音 Worker 共享的桥接令牌密钥（务必改成强随机值，二者必须一致）。
# VOICE_BRIDGE_SECRET=change-me-shared-with-core

# ---- Fish Audio TTS / STT（可选，语音前台调音台里选 fishaudio 时启用）----
# 从 https://fish.audio 控制台获取 API Key；TTS 与 STT 共用同一把 key。
# 注意：Fish 的 STT(/v1/asr) 是批量识别（非流式），延迟高于流式 STT。
# FISH_API_KEY=
# FISH_REFERENCE_ID=                        # TTS 音色模型 ID，留空用 Fish 通用音色
# FISH_MODEL=s1                             # TTS 模型：s1 / s2-pro
# FISH_BASE_URL=                            # 可选，默认 https://api.fish.audio

# ---- 阿里云 DashScope（可选，语音前台 STT=Paraformer / TTS=CosyVoice 时启用）----
# 从 https://bailian.console.aliyun.com 控制台获取 API Key（流式、端点在国内；STT/TTS 共用同一把 key）。
# DASHSCOPE_API_KEY=

# ---- 语音前台 LLM 用 Bedrock（可选）----
# 复用主 agent 的 Bedrock API Key（设置页 → Bedrock，无需额外环境变量）；
# 在调音台把「前台 LLM 供应商」选 Bedrock，模型填 claude-sonnet-4-6 等短名即可。
# ---- 可选 Codex / Cursor 标准运行模式（默认关闭）----
# 仅支持 macOS / Linux，UVICORN_WORKERS=1，适用于同一主机上的可信团队。
# Docker 整体部署也使用 local：CLI 在应用容器内执行，不是每租户隔离后端。
# 完整步骤：docs/runtime-standard-mode.md 与 docs/superadmin-console.md。
# v1.3.1：内部 Service 可使用已授权 Codex / Cursor 套餐，支持网页、API 和 Service 微信。
# 在 Service 设置中选择连接/模型，无需新增环境变量；套餐 Key 不支持 BYOK。
# 仅面向可信内部成员；套餐 Service 暂不支持定时任务、语音与视频。
# 详见 docs/runtime-service-distribution.md。
JELLYFISH_RUNTIME_ENABLED=0
JELLYFISH_RUNTIME_ACCESS_MODE=trusted_shared
JELLYFISH_RUNTIME_BACKEND=local
JELLYFISH_RUNTIME_MAX_RUNNING=2
JELLYFISH_RUNTIME_MAX_QUEUED=32
JELLYFISH_RUNTIME_QUEUE_PER_ADMIN=4
# JELLYFISH_RUNTIME_RUN_TIMEOUT=1800
# JELLYFISH_RUNTIME_APPROVAL_TIMEOUT=300

# /superadmin 用主机 key 管理连接；普通 admin 只能使用获授权的模型。
# 本机：python3 launcher.py --superadmin-key
# Docker：docker compose exec openjellyfish python launcher.py --superadmin-key
# JELLYFISH_OWNER_USER_ID 已废弃；旧连接自动迁移为主机所有。
# key 默认：本机 config/superadmin.key；Docker /app/data/superadmin.key。
# 如覆盖 JELLYFISH_SUPERADMIN_KEY_FILE，后端与 key CLI 必须使用同一进程环境变量。
# 不要把 key 内容写进此示例文件。

# Docker 可独立选装一种或两种 CLI；版本变量是构建参数，修改后必须重建。
# 以下为已有安装验证的固定版本，并非自动跟随最新版本。
# JELLYFISH_CODEX_CLI_VERSION=0.154.0
# JELLYFISH_CURSOR_CLI_VERSION=2026.09.15-d2fe57e
# docker compose up -d --build openjellyfish
# docker compose exec nginx nginx -s reload
# 容器内安装路径：/usr/local/bin/codex、/usr/local/bin/cursor-agent。
# 直接部署可以指定实际可执行文件路径；不要给容器填宿主机 macOS 路径。
# JELLYFISH_RUNTIME_CODEX_BIN=/usr/local/bin/codex
# JELLYFISH_RUNTIME_CURSOR_BIN=/usr/local/bin/cursor-agent

# 默认为项目 data/runtime（Docker 已由 /app/data 持久化）。
# 自定义目录必须可写并单独持久化；备份时同时保存数据库、vault 和加密密钥。
# JELLYFISH_RUNTIME_DATA_DIR=/private/persistent/jellyfish-runtime
# 连接级客户端预热；单连接同一时刻只运行一轮。
# MAX_CLIENTS 默认随 MAX_RUNNING，上限 16；没有可配置的 IDLE_SECONDS 开关。
# JELLYFISH_RUNTIME_MAX_CLIENTS=2
# JELLYFISH_RUNTIME_KEEP_WARM=1

# ---- 旧单管理员 Codex 试验台（标准模式无需配置）----
# 不要让旧试验台与标准模式同时使用同一供应商登录缓存。
# JELLYFISH_CODEX_PILOT=0
# JELLYFISH_CODEX_ADMIN_ID=<one Jellyfish administrator user_id>
# JELLYFISH_CODEX_BIN=/absolute/path/to/codex
# JELLYFISH_CODEX_HOME=/absolute/path/to/dedicated-codex-home
